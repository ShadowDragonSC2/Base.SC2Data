        <AssetArray File="Assets\Sounds\Protoss\WarpGate\WarpGate_MorphToGateway1.wav"/>
        <AssetArray File="Assets\Sounds\Protoss\WarpGate\WarpGate_MorphToGateway2.wav"/>
        <Volume value="-3.000000,-3.000000"/>
    </CSound>

    <!-- Taldarim Warpgate -->
    
    <CUnit id="TaldarimWarpgate" parent="TaldarimGateway">
        <AbilArray index="4" Link="TaldarimWarpgate_MorphToGateway"/>
        <CardLayouts index="0">
            <LayoutButtons index="9" Face="TaldarimWarpgate_MorphToGateway" Type="AbilCmd" AbilCmd="TaldarimWarpgate_MorphToGateway,Execute" Row="2" Column="0"/>
        </CardLayouts>
    </CUnit>
    
    <CActorUnit id="TaldarimWarpgate" parent="ProtossCollection@Building" unitName="TaldarimWarpgate">
        <On Terms="UnitConstruction.*.Start" Send="Create TaldarimProbe_Build@BuildMedium"/>
        <Aliases value="_UnitHuge"/>
        <Macros value="ProtossBuildingPowerUp"/>
        <Macros value="VoidMPUnpoweredAnim"/>
        <Macros value="QueueAnim"/>
        <Macros value="GlobalLoopMacro"/>
        <Macros value="GlobalLoopMacroMore"/>
        <On Terms="ActorCreation" Send="AnimGroupApply Superior"/>
        <!-- Morph data -->
        <On Terms="BehaviorLevel.PowerUserQueue.Start; Level 0" Send="AnimSetPaused Morph"/>
        <On Terms="BehaviorLevel.PowerUserQueue.Stop; Level 0" Send="AnimSetPaused Morph 0"/>
        <On Terms="AbilMorph.*.Start; MorphFrom TaldarimWarpgate; MorphTo TaldarimGateway" Send="Destroy"/>
        <On Terms="AbilMorph.*.Start; MorphFrom TaldarimGateway; MorphTo TaldarimWarpgate" Send="Create"/>
        <On Terms="AbilMorph.*.Start; MorphFrom TaldarimGateway; MorphTo TaldarimWarpgate" Send="AnimPlay Morph Morph 0 0.000000"/>
        <On Terms="AbilMorph.*.Finish; MorphFrom TaldarimGateway; MorphTo TaldarimWarpgate" Send="AnimClear Morph"/>

        <Model value="TaldarimGateway"/>
        <PlacementModel value="TaldarimGateway@Placement"/>
        <PortraitModel value="TaldarimGateway@Portrait"/>
        <BuildModel value="TaldarimGateway@Birth"/>
        <DeathArray index="Normal" ModelLink="TaldarimGateway@Death" SoundLink="TaldarimGateway@Death"/>

        <GlossaryAnim value="Stand,Superior"/>

        <ModelFlags index="AutomateGlobalLoops" value="0"/>
        <CreepHeightClass value="Small"/>
        <BarOffset value="140"/>
        <BarWidth value="160"/>
        <GroupIcon>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway.dds"/>
        </GroupIcon>
        <NameOffset value="130"/>
        <UnitFlags index="ShowBlobShadow" value="0"/>
        <Wireframe>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway.dds"/>
        </Wireframe>
        <WireframeShield>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield01.dds"/>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield02.dds"/>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield03.dds"/>
        </WireframeShield>
