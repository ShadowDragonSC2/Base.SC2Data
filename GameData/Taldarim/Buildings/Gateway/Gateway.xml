        <LifeMax value="500"/>
        <ShieldsStart value="500"/>
        <ShieldsMax value="500"/>
        <Radius value="1.75"/>
        <SeparationRadius value="1.75"/>
        <Footprint value="Footprint3x3Contour"/>
        <PlacementFootprint value="Footprint3x3"/>
        <ScoreMake value="150"/>
        <ScoreKill value="150"/>
        <SubgroupPriority value="2"/>
        <MinimapRadius value="1.75"/>
        <BuildTime value="65"/>
        <AbilArray Link="que5"/>
        <AbilArray Link="Rally"/>
        <AbilArray Link="TaldarimGateway_Train"/>
        <AbilArray Link="TaldarimGateway_MorphToWarpgate"/>
        <CardLayouts index="0">
            <LayoutButtons Face="Supplicant" Type="AbilCmd" AbilCmd="TaldarimGateway_Train,Train1"/>
            <LayoutButtons Face="Slayer" Type="AbilCmd" AbilCmd="TaldarimGateway_Train,Train2" Column="1"/>
            <LayoutButtons Face="Havoc" Type="AbilCmd" AbilCmd="TaldarimGateway_Train,Train3" Column="2"/>
            <LayoutButtons Face="Ascendant" Type="AbilCmd" AbilCmd="TaldarimGateway_Train,Train4" Column="3"/>
            <LayoutButtons Face="BloodHunter" Type="AbilCmd" AbilCmd="TaldarimGateway_Train,Train5" Column="4"/>

            <LayoutButtons Face="Cancel" Type="AbilCmd" AbilCmd="que5,CancelLast" Row="2" Column="4"/>
            <LayoutButtons Face="Cancel" Type="AbilCmd" AbilCmd="TaldarimGateway_MorphToWarpgate,Cancel" Row="2" Column="4"/>
            <LayoutButtons Face="Rally" Type="AbilCmd" AbilCmd="Rally,Rally1" Row="1" Column="4"/>
            <LayoutButtons Face="TaldarimGateway_MorphToWarpgate" Type="AbilCmd" AbilCmd="TaldarimGateway_MorphToWarpgate,Execute" Row="2" Column="0"/>
        </CardLayouts>
        <GlossaryPriority value="22"/>
        <CostResource index="Minerals" value="150"/>
        <TechTreeProducedUnitArray value="WarpGate"/>
        <TechTreeProducedUnitArray value="Supplicant"/>
        <TechTreeProducedUnitArray value="Havoc"/>
        <TechTreeProducedUnitArray value="Slayer"/>
        <TechTreeProducedUnitArray value="Ascendant"/>
        <TechTreeProducedUnitArray value="BloodHunter"/>
    </CUnit>

    <CActorUnit id="TaldarimGateway" parent="ProtossCollection@Building" unitName="TaldarimGateway">
        <On Terms="UnitConstruction.*.Start" Send="Create TaldarimProbe_Build@BuildMedium"/>
        <Aliases value="_UnitHuge"/>
        <Macros value="ProtossBuildingPowerUp"/>
        <Macros value="VoidMPUnpoweredAnim"/>
        <Macros value="QueueAnim"/>
        <Macros value="GlobalLoopMacro"/>
        <Macros value="GlobalLoopMacroMore"/>
        <On Terms="ActorCreation" Send="AnimGroupRemove Superior"/>
        <!-- Morph data -->
        <On Terms="BehaviorLevel.PowerUserQueue.Start; Level 0" Send="AnimSetPaused Morph"/>
        <On Terms="BehaviorLevel.PowerUserQueue.Stop; Level 0" Send="AnimSetPaused Morph 0"/>
        <On Terms="AbilMorph.*.Start; MorphFrom TaldarimGateway; MorphTo TaldarimWarpgate" Send="Destroy"/>
        <On Terms="AbilMorph.*.Start; MorphFrom TaldarimWarpgate; MorphTo TaldarimGateway" Send="Create"/>
        <On Terms="AbilMorph.*.Start; MorphFrom TaldarimWarpgate; MorphTo TaldarimGateway" Send="AnimPlay Morph Morph,End 0 0.000000"/>
        <On Terms="AbilMorph.*.Finish; MorphFrom TaldarimWarpgate; MorphTo TaldarimGateway" Send="AnimClear Morph"/>
        <ModelFlags index="AutomateGlobalLoops" value="0"/>
        <CreepHeightClass value="Small"/>
        <BarOffset value="140"/>
        <BarWidth value="160"/>
        <GroupIcon>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway.dds"/>
        </GroupIcon>
        <NameOffset value="130"/>
        <UnitFlags index="ShowBlobShadow" value="0"/>
        <Wireframe>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway.dds"/>
        </Wireframe>
        <WireframeShield>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield01.dds"/>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield02.dds"/>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield03.dds"/>
        </WireframeShield>
    </CActorUnit>

    <CModel id="TaldarimGateway" parent="BuildingEx">
        <Model value="Assets\Buildings\Protoss\Gateway_Taldarim_Collection\Gateway_Taldarim_Collection.m3"/>
        <ScaleMax value="0.800000,0.800000,0.800000"/>
        <ScaleMin value="0.800000,0.800000,0.800000"/>
        <SelectionRadius value="2.500000"/>
        <SquibTypeDefault value="Metal"/>
        <Radius value="2.000000"/>
        <ShadowRadius value="2.500000"/>
        <Events Anim="Morph" Name="MorphStart" Type="Sound" Payload="TaldarimGateway@MorphToWarpgate"/>
        <Events Anim="Morph,End" Name="MorphEnd" Type="Sound" Payload="TaldarimGateway@MorphToGateway"/>
    </CModel>
    <CModel id="TaldarimGateway@Death" parent="BuildingDeathEx">
        <Model value="Assets\Buildings\Protoss\Gateway_Taldarim_Death\Gateway_Taldarim_Death.m3"/>
    </CModel>
    <CModel id="TaldarimGateway@Placement" parent="PlacementEx">
