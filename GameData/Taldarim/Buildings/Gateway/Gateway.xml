        <ScaleMax value="0.800000,0.800000,0.800000"/>
        <ScaleMin value="0.800000,0.800000,0.800000"/>
    </CModel>
    <CModel id="TaldarimGateway@Birth" parent="TaldarimGateway">
        <Model value="Assets\Buildings\Protoss\Gateway_Taldarim_WarpIn\Gateway_Taldarim_WarpIn.m3"/>
        <Events>
            <Anim value="Stand,Build,End"/>
            <Name value="BuildingWarpIn"/>
            <Type value="Sound"/>
            <Time value="1.333300"/>
