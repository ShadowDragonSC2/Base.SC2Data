    <CSound id="TaldarimGateway@Death" parent="Protoss_ExplosionLarge"/>
    <CSound id="TaldarimGateway@What" parent="Voice">
        <AssetArray File="Assets\Sounds\Protoss\Gateway\Gateway_What.ogg"/>
        <EditorCategories value="Race:Protoss"/>
        <Volume value="-4.500000,-4.500000"/>
    </CSound>
    <CSound id="TaldarimGateway@Ready" parent="Ready">
        <AssetArray File="Assets\Sounds\Protoss\Gateway\Gateway_What.ogg"/>
        <EditorCategories value="Race:Protoss"/>
        <Volume value="-4.500000,-4.500000"/>
    </CSound>
    <CSound id="TaldarimGateway@MorphToWarpgate" parent="Build">
